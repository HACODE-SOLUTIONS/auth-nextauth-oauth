# NextAuth / Auth.js Configuration
# Copy this file to .env.local and fill in your values

# ========================================
# Required: NextAuth Configuration
# ========================================

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Application URL (update for production)
AUTH_URL=http://localhost:3000

# Production: Enable host trust (or use AUTH_URL)
# AUTH_TRUST_HOST=true

# ========================================
# OAuth Providers
# ========================================

# GitHub OAuth
# Setup: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Google OAuth
# Setup: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

# Azure AD (Optional)
# Setup: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Callback URL: http://localhost:3000/api/auth/callback/azure-ad
# AZURE_AD_CLIENT_ID=your-azure-client-id
# AZURE_AD_CLIENT_SECRET=your-azure-client-secret
# AZURE_AD_TENANT_ID=your-tenant-id-or-common

# Custom OIDC Provider (Optional)
# Examples: Keycloak, Auth0, Okta
# Callback URL: http://localhost:3000/api/auth/callback/custom-oidc
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_ISSUER=https://your-oidc-provider.com/realms/your-realm

# ========================================
# Database (Optional - for database sessions)
# ========================================

# PostgreSQL example
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# MySQL example
# DATABASE_URL=mysql://user:password@localhost:3306/mydb

# SQLite example (for development)
# DATABASE_URL=file:./dev.db

# ========================================
# Optional: Advanced Configuration
# ========================================

# Redirect proxy URL (for development with tunnels)
# AUTH_REDIRECT_PROXY_URL=https://your-tunnel-url.com

# Debug mode (shows detailed auth logs)
# AUTH_DEBUG=true

# Custom base path (if auth is not at /api/auth)
# AUTH_BASE_PATH=/custom-auth
